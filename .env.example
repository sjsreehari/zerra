# ──────────────────────────────────────────────────────────
# Zerra Configuration (.env)
# Copy to .env and configure values before deployment
# ──────────────────────────────────────────────────────────

# ── General Environment ──
ENVIRONMENT=development
BASE_DOMAIN=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ZERRA_URL=http://localhost:8000
ZERRA_DB_PATH=agent/zerra.db

# ── Security & Authentication ──
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_64_CHARS
JWT_TTL_HOURS=24

# ── GitHub Integration & Auto-PR ──
GITHUB_TOKEN=ghp_CHANGE_ME_WITH_REPO_SCOPE_PAT
GITHUB_WEBHOOK_SECRET=zerra-webhook-secret-token

# ── Notification Channels ──
# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT=

# Discord
DISCORD_WEBHOOK_URL=

# Microsoft Teams
TEAMS_WEBHOOK_URL=

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_TO=

# ── Database (PostgreSQL for Go Gateway sessions) ──
POSTGRES_DB=zerra
POSTGRES_USER=zerra
POSTGRES_PASSWORD=zerra-secure-password
DB_CONN_STR=postgres://zerra:zerra-secure-password@postgres:5432/zerra?sslmode=disable

# ── Optional Local LLM (Ollama) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ZERRA_INFERENCE_URL=http://localhost:8000
ZERRA_INFERENCE_ENABLED=true
