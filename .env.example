# ────────────────────────────────────────────────────────────────────────────
# Zerra Environment Configuration
# Copy this file to .env and fill in the values you need.
# Never commit your .env file to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── GitHub Integration ───────────────────────────────────────────────────────
# Personal Access Token (PAT) for opening Pull Requests from your machine.
# Required permissions: Contents (R/W), Pull Requests (R/W), Issues (R/W).
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Webhook secret — set if you expose Zerra to receive GitHub push/PR webhooks.
GITHUB_WEBHOOK_SECRET=

# ── AI Fix Synthesis (Optional) ──────────────────────────────────────────────
# Local Ollama — 100% private, no API key needed if you run Ollama locally.
# Install: https://ollama.ai | Default model: llama3.2
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Anthropic Claude — optional; used for AI fix generation if Ollama unavailable
# NOTE: Using this will send code context to api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-20240307

# OpenAI — optional fallback for AI fix generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Vault Master Key (Optional Fallback) ─────────────────────────────────────
# By default, Zerra uses your operating system keychain (Windows Credential Manager,
# macOS Keychain, Linux Secret Service). If no keychain is available (e.g. headless Docker),
# you can provide a base64-encoded 32-byte key here:
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ZERRA_VAULT_KEY=

# ── Dashboard & Agent Ports ──────────────────────────────────────────────────
ZERRA_INFERENCE_PORT=8000
ZERRA_DASHBOARD_PORT=3000
NEXT_PUBLIC_ZERRA_URL=http://localhost:8000
LOG_LEVEL=info
