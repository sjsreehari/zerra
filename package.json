{
  "name": "zerra",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*", "cli"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "vitest run",
    "prisma:generate": "prisma generate --schema packages/schema/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema packages/schema/prisma/schema.prisma"
  },
  "devDependencies": {"@types/node": "^22.10.2", "prisma": "^6.1.0", "tsx": "^4.19.2", "typescript": "^5.7.2", "vitest": "^2.1.8"}
}
