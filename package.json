{
  "name": "zerra",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*", "cli"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "vitest run",
    "prisma:generate": "prisma generate --schema packages/schema/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema packages/schema/prisma/schema.prisma"
  },
  "devDependencies": {"@types/node": "^26.6.4", "prisma": "^7.10.0", "tsx": "^4.23.15", "typescript": "^7.0.2", "vitest": "^5.0.3"}
}
